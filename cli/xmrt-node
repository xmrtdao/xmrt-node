# ── Utilities ───────────────────────────────────────────────────────────────

def color(text, code):
    """Print colored text (Termux compatible)."""
    return f"\033[{code}m{text}\033[0m"

def info(msg):    print(color("[*]", "36"), msg)
def ok(msg):      print(color("[+]", "32"), msg)
def warn(msg):    print(color("[!]", "33"), msg)
def err(msg):     print(color("[X]", "31"), msg)

def ensure_config_dir():
    CONFIG_DIR.mkdir(parents=True, exist_ok=True)

def load_config():
    ensure_config_dir()
    if CONFIG_FILE.exists():
        return json.loads(CONFIG_FILE.read_text())
    return {
        "wallet": POOL_WALLET,
        "pool": POOL_URL,
        "worker": f"android-{random.randint(1000,9999)}",
        "relay_url": RELAY_URL,
        "max_cpu": 75,
        "auto_start": False,
    }

def save_config(cfg):
    ensure_config_dir()
    CONFIG_FILE.write_text(json.dumps(cfg, indent=2))
    ok(f"Config saved to {CONFIG_FILE}")

def relay_get(path):
    """GET request to the relay API."""
    try:
        req = urllib.request.Request(f"{RELAY_URL}{path}", headers={"User-Agent": NAME})
        with urllib.request.urlopen(req, timeout=10) as r:
            return json.loads(r.read())
    except Exception as e:
        return {"error": str(e)}

def relay_post(path, data):
    """POST to the relay API."""
    try:
        body = json.dumps(data).encode()
        req = urllib.request.Request(
            f"{RELAY_URL}{path}",
            data=body,
            headers={
                "Content-Type": "application/json",
                "User-Agent": NAME,
                # The relay gates its fleet endpoints on x-api-key. Without this
                # header the request is anonymous, so heartbeats are attributed
                # to no agent and never reach the fleet registry.
                "x-api-key": RELAY_API_KEY,
            }
        )
        with urllib.request.urlopen(req, timeout=10) as r:
            return json.loads(r.read())
    except urllib.error.HTTPError as e:
        return {"error": f"HTTP {e.code}: {e.read().decode()[:200]}"}
    except Exception as e:
        return {"error": str(e)}


def _stats_digest(stats):
    """Reduce an XMRig /1/summary payload to the fields the relay tracks.

    Keep hashrate at the top level of the heartbeat: the relay stores it as a
    scalar field on the agent record and renders it on the dashboard. Nested
    it under "stats" and the fleet shows 0 H/s even though the miner is
    hashing.
    """
    if not stats:
        return 0, {}
    hashrate = stats.get("hashrate", {}) or {}
    total = hashrate.get("total") or [0, 0, 0]
    # total = [10s, 60s, 15m]; prefer the 60s figure over the 10s one, which
    # swings wildly right after a restart and reads as a false spike.
    hr = total[1] if len(total) > 1 and total[1] else (total[0] or 0)
    conn = stats.get("connection", {}) or {}
    digest = {
        "worker": stats.get("worker_id"),
        "pool": conn.get("pool"),
        "algo": stats.get("algo"),
        "ping_ms": conn.get("ping"),
        "accepted": conn.get("accepted"),
        "rejected": conn.get("rejected"),
        "failures": conn.get("failures"),
        "shares_good": (stats.get("results", {}) or {}).get("shares_good"),
        "uptime": stats.get("uptime"),
        "donate_level": stats.get("donate_level"),
    }
    return hr, {k: v for k, v in digest.items() if v is not None}


def heartbeat(cfg, stats=None):
    """Send fleet heartbeat to the relay.

    The relay rejects this with 400 unless the body carries `agent_id` and
    `status`; it reads hashrate from a top-level field, not from a nested
    stats blob. Wallet stays out of the payload — the fleet only needs the
    worker name and pool to track the rig.
    """
    hr, digest = _stats_digest(stats)
    running = get_xmrig_pid() is not None
    payload = {
        "agent_id": AGENT_ID,
        "name": "XMRT Node (Termux)",
        "role": "miner",
        "status": "ONLINE" if (running and stats) else "OFFLINE",
        "hashrate": round(hr, 2),
        "device_type": "android-termux",
        "version": VERSION,
        "metadata": {
            **digest,
            "worker": digest.get("worker") or cfg.get("worker"),
            "pool": digest.get("pool") or cfg.get("pool"),
            "pid": get_xmrig_pid(),
        },
    }
    return relay_post("/api/fleet/heartbeat", payload)

def _running_xmrig_pids():
    """Find live XMRig processes by scanning /proc, lowest PID first.

    Reading PID_FILE alone is not enough: Termux:Boot starts the miner from
    ~/.termux/boot/start-xmrig.sh, which never writes the CLI's PID file. The
    CLI then reports STOPPED against a healthy miner, and `stop` refuses to
    act on a process it cannot see. Match on the binary path instead of a
    single pid file so any launcher is visible.

    Returns a list of pids whose argv names a known XMRig binary. Match the
    binary path across the whole argv vector rather than only argv[0]: the
    boot script `exec`s into xmrig, so a real miner always has the binary as
    argv[0], while a miner launched via a wrapper may carry it later. Require
    a full path match so an unrelated command line that merely mentions
    "xmrig" (a grep over logs, an editor) cannot be mistaken for a miner.
    """
    candidates = [str(XMRIG_BIN), str(CANONICAL_XMRIG_BIN)]
    me = os.getpid()
    pids = []
    for entry in os.listdir("/proc"):
        if not entry.isdigit():
            continue
        pid = int(entry)
        if pid == me:
            continue
        try:
            raw = Path(f"/proc/{pid}/cmdline").read_bytes()
        except (FileNotFoundError, ProcessLookupError, PermissionError):
            continue
        argv = [a for a in raw.decode("utf-8", "replace").split("\0") if a]
        if not argv:
            continue
        # A shell wrapper puts the binary in a later arg; a direct exec puts
        # it first. Accept either, but require a real path match so a stray
        # "xmrig" in an unrelated command line cannot match.
        if any(cand in arg for arg in argv for cand in candidates):
            pids.append(pid)
    return sorted(pids)


def get_xmrig_pid():
    """Resolve the running XMRig pid, preferring the PID file, then /proc.

    Returns None when nothing is running. A stale PID file is cleaned up
    rather than trusted, and a live miner found via /proc is adopted into
    the PID file so later single-pid callers stay correct.
    """
    if PID_FILE.exists():
        try:
            pid = int(PID_FILE.read_text().strip())
            os.kill(pid, 0)
            return pid
        except (ProcessLookupError, ValueError, OSError):
            PID_FILE.unlink(missing_ok=True)

    live = _running_xmrig_pids()
    if live:
        PID_FILE.parent.mkdir(parents=True, exist_ok=True)
        PID_FILE.write_text(str(live[0]))
        return live[0]
    return None

def get_xmrig_stats():
    """Get mining stats from the XMRig API."""
    try:
        req = urllib.request.Request(f"http://127.0.0.1:{API_PORT}/1/summary")
        with urllib.request.urlopen(req, timeout=5) as r:
            return json.loads(r.read())
    except Exception:
        return None

