            with urllib.request.urlopen(req, timeout=2) as r:
                data = json.loads(r.read())
                print(f"Health endpoint: {r.status} (status={data.get('status')})")
                if "providers" in data:
                    print(f"Primary model:   {data['providers'][0].get('model', '?')}")
                if "tools" in data:
                    print(f"Tools loaded:    {len(data['tools'])}")
                if "skills" in data:
                    print(f"Skills loaded:   {len(data['skills'])}")
        except Exception as e:
            warn(f"Health check failed: {e}")


def agent_logs():
    if not AGENT_LOG.exists():
        warn("No log file yet")
        return
    try:
        # tail -n 50 equivalent
        with open(AGENT_LOG, "rb") as f:
            f.seek(0, 2)
            size = f.tell()
            block = 4096
            data = b""
            while size > 0 and len(data) < 50_000:
                read_size = min(block, size)
                f.seek(size - read_size)
                data = f.read(read_size) + data
                size -= read_size
            text = data.decode("utf-8", errors="replace")
            lines = text.splitlines()[-50:]
            print("\n".join(lines))
    except Exception as e:
        err(f"Failed to read log: {e}")


def agent_chat(message):
    """Quick non-streaming chat via the agent."""
    pid = agent_get_pid()
    if not pid:
        err("Agent not running. Run: xmrt-node agent start")
        return
    import urllib.error
    payload = json.dumps({
        "model": "deepseek-v4-flash:cloud",
        "messages": [{"role": "user", "content": message}],
        "stream": False,
    }).encode()
    req = urllib.request.Request(
        f"http://127.0.0.1:{AGENT_PORT}/v1/chat/completions",
        data=payload,
        headers={"Content-Type": "application/json", "User-Agent": NAME},
    )
    try:
        with urllib.request.urlopen(req, timeout=120) as r:
            data = json.loads(r.read())
            choices = data.get("choices", [])
            if choices:
                content = choices[0].get("message", {}).get("content", "")
                print(content)
    except urllib.error.URLError as e:
        err(f"Chat failed: {e}")


# ── Main ────────────────────────────────────────────────────────────────────

def main():
    if len(sys.argv) < 2:
        print(f"XMRT-Node CLI v{VERSION} — Termux-Compatible Android Mining Node")
        print()
        print("Usage: xmrt-node <command> [args]")
        print()
        print("Commands:")
        print("  install         Install XMRig and set up the environment")
        print("  start           Start the mining daemon")
        print("  stop            Stop the mining daemon")
        print("  status          Show node and fleet status")
        print("  logs            View recent mining logs")
        print("  peers           List fleet peers")
        print("  config          View or modify config (key=value)")
        print()
        print("Agent commands (optional, requires Termux:API + Ollama):")
        print("  agent install   Install the Python agent from <repo>/agent/")
        print("  agent start     Start agent on port 8642")
        print("  agent stop      Stop the agent")
        print("  agent status    Show agent health + model info")
        print("  agent logs      Tail agent log")
        print("  agent chat MSG  Send one message, get reply")
        print()
        print("Report: https://relay.mobilemonero.com")
        return

    command = sys.argv[1]
    args = sys.argv[2:]

    commands = {
        "install": cmd_install,
        "start": cmd_start,
        "stop": cmd_stop,
        "status": cmd_status,
        "logs": cmd_logs,
        "peers": cmd_peers,
    }

    if command == "config":
        cmd_config(args)
    elif command == "agent":
        if len(sys.argv) < 3:
            err("Usage: xmrt-node agent <install|start|stop|status|logs|chat>")
            return
        sub = sys.argv[2]
        if sub == "install":
            agent_install()
        elif sub == "start":
            agent_start()
        elif sub == "stop":
            agent_stop()
        elif sub == "status":
            agent_status()
        elif sub == "logs":
            agent_logs()
        elif sub == "chat":
            if len(sys.argv) < 4:
                err("Usage: xmrt-node agent chat <message>")
            else:
                agent_chat(" ".join(sys.argv[3:]))
        else:
            err(f"Unknown agent subcommand: {sub}")
    elif command in commands:
        commands[command]()
    else:
        err(f"Unknown command: {command}")
        print("Run 'xmrt-node' without arguments for help.")
        sys.exit(1)


if __name__ == "__main__":
    main()
