def main():
    if len(sys.argv) < 2:
        print(f"XMRT-Node CLI v{VERSION} — Termux-Compatible Android Mining Node")
        print()
        print("Usage: xmrt-node <command> [args]")
        print()
        print("Commands:")
        print("  install         Install XMRig and set up the environment")
        print("  start           Start the mining daemon")
        print("  stop            Stop the mining daemon")
        print("  status          Show node and fleet status")
        print("  logs            View recent mining logs")
        print("  peers           List fleet peers")
        print("  config          View or modify config (key=value)")
        print()
        print("Agent commands (optional, requires Termux:API + Ollama):")
        print("  agent install   Install the Python agent from <repo>/agent/")
        print("  agent start     Start agent on port 8642")
        print("  agent stop      Stop the agent")
        print("  agent status    Show agent health + model info")
        print("  agent logs      Tail agent log")
        print("  agent chat MSG  Send one message, get reply")
        print()
        print("Report: https://relay.mobilemonero.com")
        return

    command = sys.argv[1]
    args = sys.argv[2:]

    commands = {
        "install": cmd_install,
        "start": cmd_start,
        "stop": cmd_stop,
        "status": cmd_status,
        "heartbeat": cmd_heartbeat,
        "watch": cmd_watch,
        "logs": cmd_logs,
        "peers": cmd_peers,
    }

    if command == "config":
        cmd_config(args)
    elif command == "agent":
        if len(sys.argv) < 3:
            err("Usage: xmrt-node agent <install|start|stop|status|logs|chat>")
            return
        sub = sys.argv[2]
        if sub == "install":
            agent_install()
        elif sub == "start":
            agent_start()
        elif sub == "stop":
            agent_stop()
        elif sub == "status":
            agent_status()
        elif sub == "logs":
            agent_logs()
        elif sub == "chat":
            if len(sys.argv) < 4:
                err("Usage: xmrt-node agent chat <message>")
            else:
                agent_chat(" ".join(sys.argv[3:]))
        else:
            err(f"Unknown agent subcommand: {sub}")
    elif command in commands:
        # Propagate the command's return value as the process exit code so a
        # scheduler can react to failure; previously every command exited 0
        # regardless of what happened.
        sys.exit(commands[command]() or 0)
    else:
        err(f"Unknown command: {command}")
        print("Run 'xmrt-node' without arguments for help.")
        sys.exit(1)


if __name__ == "__main__":
    main()
