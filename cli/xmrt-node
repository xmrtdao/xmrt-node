#!/usr/bin/env python3
"""
XMRT-Node CLI — Termux-Compatible Android Mining Node
=====================================================
Commands:
  xmrt-node status    — Check node health, mining stats, fleet status
  xmrt-node start     — Start the XMRig mining daemon
  xmrt-node stop      — Stop the mining daemon
  xmrt-node logs      — View recent mining logs
  xmrt-node peers     — List fleet peers from the relay mesh
  xmrt-node config    — View or modify configuration
  xmrt-node install   — Run the Termux setup/install process

Part of the XMRT-DAO fleet. Reports to relay.mobilemonero.com
"""

import os
import sys
import json
import time
import signal
import subprocess
import hashlib
import random
import fcntl
import urllib.request
import urllib.error
from pathlib import Path
from datetime import datetime, timezone

# ── Constants ───────────────────────────────────────────────────────────────
VERSION = "1.0.0"
NAME = "xmrt-node"

RELAY_URL = "https://relay.mobilemonero.com"
# Credential resolution, in order: XMRT_API_KEY in the environment, then a
# key file outside version control. The env var alone is not enough —
# Termux:Boot runs its scripts without the interactive shell's environment,
# so a key exported in ~/.profile is absent at boot and every heartbeat
# answers 401. Never hardcode the key and never commit it.
RELAY_KEY_FILE = Path.home() / ".config" / NAME / "relay.key"
# Stable identity for the fleet registry. The relay keys its agent records on
# this value, so it must not change between heartbeats or the rig registers
# as a new agent each time.
AGENT_ID = "xmrt-node"
POOL_URL = "pool.mobilemonero.com:3333"
POOL_WALLET = "46UxNFuGM2E3UwmZWWJicaRPoRwqwW4byQkaTHkX8yPcVihp91qAVtSFipWUGJJUyTXgzSqxzDQtNLf2bsp2DX2qCCgC5mg"
XMRIG_VERSION = "6.21.1"

# Must match the API port of the XMRig config actually in use. The stock
# repo generated 19090 while the deployed rig listens on 4321, so every
# stats call in this CLI silently returned None against a healthy miner.
API_PORT = 4321

HOME = Path.home()
CONFIG_DIR = HOME / ".config" / NAME
DEVICE_ID_FILE = CONFIG_DIR / "device.id"
COUNTERS_FILE = CONFIG_DIR / "share_counters.json"
SESSION_FILE = CONFIG_DIR / "miner_session.json"
CONFIG_FILE = CONFIG_DIR / "config.json"
PID_FILE = CONFIG_DIR / "xmrig.pid"
LOG_FILE = CONFIG_DIR / "xmrig.log"
XMRIG_LOG = CONFIG_DIR / "xmrig-xmrig.log"
LOCK_FILE = CONFIG_DIR / "xmrig.lock"
XMRIG_DIR = CONFIG_DIR / "xmrig"
XMRIG_BIN = XMRIG_DIR / "xmrig"
# The rig actually in production is built from ~/xmrig, not from the CLI's
# own config dir, and the boot script launches it from there. Both paths must
# be recognised when looking for a running miner.
CANONICAL_XMRIG_BIN = HOME / "xmrig" / "build" / "xmrig"
INSTALL_MARKER = CONFIG_DIR / ".installed"

# ── Utilities ───────────────────────────────────────────────────────────────

def color(text, code):
    """Print colored text (Termux compatible)."""
    return f"\033[{code}m{text}\033[0m"

def info(msg):    print(color("[*]", "36"), msg)
def ok(msg):      print(color("[+]", "32"), msg)
def warn(msg):    print(color("[!]", "33"), msg)
def err(msg):     print(color("[X]", "31"), msg)

def ensure_config_dir():
    CONFIG_DIR.mkdir(parents=True, exist_ok=True)

def load_config():
    ensure_config_dir()
    if CONFIG_FILE.exists():
        return json.loads(CONFIG_FILE.read_text())
    return {
        "wallet": POOL_WALLET,
        "pool": POOL_URL,
        "worker": f"android-{random.randint(1000,9999)}",
        "relay_url": RELAY_URL,
        "max_cpu": 75,
        "auto_start": False,
    }

def save_config(cfg):
    ensure_config_dir()
    CONFIG_FILE.write_text(json.dumps(cfg, indent=2))
    ok(f"Config saved to {CONFIG_FILE}")

def relay_get(path):
    """GET request to the relay API."""
    try:
        req = urllib.request.Request(
            f"{RELAY_URL}{path}",
            headers={"User-Agent": NAME, "x-api-key": relay_api_key()},
        )
        with urllib.request.urlopen(req, timeout=10) as r:
            return json.loads(r.read())
    except urllib.error.HTTPError as e:
        return {"error": f"HTTP {e.code}: {e.read().decode()[:200]}"}
    except Exception as e:
        return {"error": str(e)}

def relay_api_key():
    """Resolve the relay credential: env var first, then a key file.

    Read at call time so a key can be installed without restarting the
    heartbeat loop. Returns "" when neither source has a key, which makes
    the relay answer 401 and the caller report it rather than posting
    anonymously.
    """
    key = os.environ.get("XMRT_API_KEY", "").strip()
    if key:
        return key
    try:
        if RELAY_KEY_FILE.exists():
            return RELAY_KEY_FILE.read_text().strip()
    except OSError:
        pass
    return ""


def relay_post(path, data):
    """POST to the relay API."""
    try:
        body = json.dumps(data).encode()
        req = urllib.request.Request(
            f"{RELAY_URL}{path}",
            data=body,
            headers={
                "Content-Type": "application/json",
                "User-Agent": NAME,
                # The relay gates its fleet endpoints on x-api-key. Without this
                # header the request is anonymous, so heartbeats are attributed
                # to no agent and never reach the fleet registry.
                "x-api-key": relay_api_key(),
            }
        )
        with urllib.request.urlopen(req, timeout=10) as r:
            return json.loads(r.read())
    except urllib.error.HTTPError as e:
        return {"error": f"HTTP {e.code}: {e.read().decode()[:200]}"}
    except Exception as e:
        return {"error": str(e)}


def _android_props():
    """Read stable Android build properties via getprop.

    /system/build.prop is not readable as an unprivileged Termux app, and
    /proc/cpuinfo on this device exposes only generic "processor: 0..N"
    lines — no model. getprop is the one source that yields a real
    distinguishing value (ro.product.model). Serial numbers are
    deliberately not used: they are PII and some devices return empty.
    """
    wanted = ("ro.product.model", "ro.product.device", "ro.build.display.id")
    values = []
    for prop in wanted:
        try:
            out = subprocess.run(
                ["getprop", prop],
                capture_output=True, text=True, timeout=5,
            ).stdout.strip()
        except (OSError, subprocess.SubprocessError):
            out = ""
        if out:
            values.append(out)
    return values


def device_id():
    """Stable, machine-derived identity for this rig.

    The pool worker name ("joe") is an arbitrary alias: anyone can set it,
    it collides across devices, and it proves nothing about which hardware
    earned a share. Rewards attribution needs an identity tied to the
    device instead.

    Derived from the hardware model, Android build, and architecture, then
    sha256-truncated. Nothing here is PII (no serial, no wallet, no
    account) and none of it changes across reboots.

    Uniqueness caveat, verified rather than assumed: model + build + ABI is
    a *fleet-class* identity, not a per-unit one. Two phones of the same
    model on the same build produce the same id, because Android exposes no
    unprivileged unique hardware identifier. It is stable and materially
    better than a self-chosen worker alias, but for true per-unit rewards
    attribution the id needs binding to an authenticated account at
    registration time. Persisted on first use so the value never drifts.
    """
    if DEVICE_ID_FILE.exists():
        try:
            existing = DEVICE_ID_FILE.read_text().strip()
            if existing:
                return existing
        except OSError:
            pass

    parts = []
    parts.extend(_android_props())
    parts.append(f"abi:{os.uname().machine}")

    # Core count is a weak signal on its own (identical across same-model
    # devices) but it does distinguish genuinely different hardware, and it
    # costs nothing.
    try:
        parts.append(f"cores:{os.cpu_count()}")
    except Exception:
        pass

    if not parts:
        parts.append(str(HOME))

    digest = hashlib.sha256("|".join(parts).encode()).hexdigest()
    device = f"dev-{digest[:16]}"
    try:
        ensure_config_dir()
        DEVICE_ID_FILE.write_text(device)
        os.chmod(DEVICE_ID_FILE, 0o600)
    except OSError:
        pass
    return device


def _miner_session_id(stats, pid):
    """Identify this miner process, so a counter reset is detectable.

    XMRig resets shares_good to 0 when the process restarts. Without a way to
    tell "counter reset" from "counter went down", a restart looks like the
    rig losing thousands of shares, and a delta computed across the boundary
    is garbage. Key the session on pid plus start time: a new pid, or the
    same pid with a newer start time, is a different session.
    """
    start = None
    if pid:
        try:
            stat = Path(f"/proc/{pid}/stat").read_text()
            # Field 22 is starttime; comm can contain spaces, so split after
            # the final ')'.
            tail = stat[stat.rfind(")") + 1:].split()
            start = int(tail[19])
        except (OSError, ValueError, IndexError):
            start = None
    return f"{pid or 'unknown'}-{start or 'unknown'}"


def detect_share_delta(stats, pid=None):
    """Compute newly-accepted shares since the previous observation.

    Returns a dict describing the change, ready to be embedded in a
    heartbeat:

        {shares_accepted, shares_rejected, session_id, session_reset,
         cumulative_accepted, cumulative_rejected, observed_at}

    Why deltas rather than raw totals: the relay stores one mutable record
    per agent, so a cumulative counter is overwritten every beat and its
    history is unrecoverable. Rewards attribution needs the increments.

    Counter resets are the failure mode to get right. A restart drops
    shares_good to 0; naive subtraction yields a large negative delta that
    looks like data loss. On a reset we report the new process's count as
    the delta (everything it has earned so far) and flag session_reset, so
    the consumer knows not to treat it as a discontinuity.

    Returns None when there is nothing to report, so a steady rig does not
    emit an event on every beat.
    """
    if not stats:
        return None

    results = stats.get("results", {}) or {}
    conn = stats.get("connection", {}) or {}
    accepted = int(results.get("shares_good") or 0)
    rejected = int(results.get("shares_rejected") or 0)
    session_id = _miner_session_id(stats, pid)

    try:
        prior = json.loads(COUNTERS_FILE.read_text())
        if not isinstance(prior, dict):
            prior = {}
    except (OSError, ValueError):
        prior = {}

    session_reset = False
    d_accept = accepted
    d_reject = rejected

    if prior.get("session_id") == session_id:
        # Same process: the increment is the difference.
        prev_acc = int(prior.get("accepted") or 0)
        prev_rej = int(prior.get("rejected") or 0)
        d_accept = accepted - prev_acc
        d_reject = rejected - prev_rej
        if d_accept < 0 or d_reject < 0:
            # Counts went backwards within one session: XMRig reconciled or
            # the API was re-read mid-reset. Treat as a reset rather than
            # reporting a negative delta.
            session_reset = True
            d_accept = accepted
            d_reject = rejected
    else:
        # New process. Everything it has earned is new to us.
        session_reset = True

    try:
        ensure_config_dir()
        COUNTERS_FILE.write_text(json.dumps({
            "accepted": accepted,
            "rejected": rejected,
            "session_id": session_id,
            "observed_at": datetime.now(timezone.utc).isoformat(),
        }))
    except OSError:
        pass

    if d_accept == 0 and d_reject == 0 and not session_reset:
        return None

    return {
        "shares_accepted": d_accept,
        "shares_rejected": d_reject,
        "session_id": session_id,
        "session_reset": session_reset,
        "cumulative_accepted": accepted,
        "cumulative_rejected": rejected,
        "observed_at": datetime.now(timezone.utc).isoformat(),
    }


def _stats_digest(stats):
    """Reduce an XMRig /1/summary payload to the fields the relay tracks.

    Keep hashrate at the top level of the heartbeat: the relay stores it as a
    scalar field on the agent record and renders it on the dashboard. Nested
    it under "stats" and the fleet shows 0 H/s even though the miner is
    hashing.
    """
    if not stats:
        return 0, {}
    hashrate = stats.get("hashrate", {}) or {}
    total = hashrate.get("total") or [0, 0, 0]
    # total = [10s, 60s, 15m]; prefer the 60s figure over the 10s one, which
    # swings wildly right after a restart and reads as a false spike.
    hr = total[1] if len(total) > 1 and total[1] else (total[0] or 0)
    conn = stats.get("connection", {}) or {}
    digest = {
        "worker": stats.get("worker_id"),
        "pool": conn.get("pool"),
        "algo": stats.get("algo"),
        "ping_ms": conn.get("ping"),
        "accepted": conn.get("accepted"),
        "rejected": conn.get("rejected"),
        "failures": conn.get("failures"),
        "shares_good": (stats.get("results", {}) or {}).get("shares_good"),
        "uptime": stats.get("uptime"),
        "donate_level": stats.get("donate_level"),
    }
    return hr, {k: v for k, v in digest.items() if v is not None}


def heartbeat(cfg, stats=None):
    """Send fleet heartbeat to the relay.

    The relay rejects this with 400 unless the body carries `agent_id` and
    `status`; it reads hashrate from a top-level field, not from a nested
    stats blob. Wallet stays out of the payload — the fleet only needs the
    worker name and pool to track the rig.

    device_id is carried so rewards can be attributed to hardware rather
    than to the pool worker name, which is an arbitrary alias anyone can
    set. share_delta carries only the increment since the previous beat, so
    a consumer can persist an event series instead of a counter that is
    overwritten in place.
    """
    hr, digest = _stats_digest(stats)
    pid = get_xmrig_pid()
    running = pid is not None
    delta = detect_share_delta(stats, pid)
    payload = {
        "agent_id": AGENT_ID,
        "name": "XMRT Node (Termux)",
        "role": "miner",
        "status": "ONLINE" if (running and stats) else "OFFLINE",
        "hashrate": round(hr, 2),
        "device_type": "android-termux",
        "device_id": device_id(),
        "version": VERSION,
        "metadata": {
            **digest,
            "worker": digest.get("worker") or cfg.get("worker"),
            "pool": digest.get("pool") or cfg.get("pool"),
            "pid": pid,
            "device_id": device_id(),
        },
    }
    if delta:
        payload["share_delta"] = delta
        payload["metadata"]["share_delta"] = delta
    return relay_post("/api/fleet/heartbeat", payload)

def _running_xmrig_pids():
    """Find live XMRig processes by scanning /proc, lowest PID first.

    Reading PID_FILE alone is not enough: Termux:Boot starts the miner from
    ~/.termux/boot/start-xmrig.sh, which never writes the CLI's PID file. The
    CLI then reports STOPPED against a healthy miner, and `stop` refuses to
    act on a process it cannot see. Match on the binary path instead of a
    single pid file so any launcher is visible.

    Returns a list of pids whose argv names a known XMRig binary. Match the
    binary path across the whole argv vector rather than only argv[0]: the
    boot script `exec`s into xmrig, so a real miner always has the binary as
    argv[0], while a miner launched via a wrapper may carry it later. Require
    a full path match so an unrelated command line that merely mentions
    "xmrig" (a grep over logs, an editor) cannot be mistaken for a miner.
    """
    candidates = [str(XMRIG_BIN), str(CANONICAL_XMRIG_BIN)]
    me = os.getpid()
    pids = []
    for entry in os.listdir("/proc"):
        if not entry.isdigit():
            continue
        pid = int(entry)
        if pid == me:
            continue
        try:
            raw = Path(f"/proc/{pid}/cmdline").read_bytes()
        except (FileNotFoundError, ProcessLookupError, PermissionError):
            continue
        argv = [a for a in raw.decode("utf-8", "replace").split("\0") if a]
        if not argv:
            continue
        # A shell wrapper puts the binary in a later arg; a direct exec puts
        # it first. Accept either, but require a real path match so a stray
        # "xmrig" in an unrelated command line cannot match.
        if any(cand in arg for arg in argv for cand in candidates):
            pids.append(pid)
    return sorted(pids)


def get_xmrig_pid():
    """Resolve the running XMRig pid, preferring the PID file, then /proc.

    Returns None when nothing is running. A stale PID file is cleaned up
    rather than trusted, and a live miner found via /proc is adopted into
    the PID file so later single-pid callers stay correct.
    """
    if PID_FILE.exists():
        try:
            pid = int(PID_FILE.read_text().strip())
            os.kill(pid, 0)
            return pid
        except (ProcessLookupError, ValueError, OSError):
            PID_FILE.unlink(missing_ok=True)

    live = _running_xmrig_pids()
    if live:
        PID_FILE.parent.mkdir(parents=True, exist_ok=True)
        PID_FILE.write_text(str(live[0]))
        return live[0]
    return None

def get_xmrig_stats():
    """Get mining stats from the XMRig API."""
    try:
        req = urllib.request.Request(f"http://127.0.0.1:{API_PORT}/1/summary")
        with urllib.request.urlopen(req, timeout=5) as r:
            return json.loads(r.read())
    except Exception:
        return None

