def cmd_install():
    """Install XMRig and set up the environment."""
    info("Starting XMRT-Node Android CLI installation...")
    ensure_config_dir()

    # Detect architecture
    arch = subprocess.getoutput("uname -m").strip()
    if arch not in ("aarch64", "armv7l", "armv8l"):
        warn(f"Untested architecture: {arch}. Proceeding anyway.")

    info(f"Architecture: {arch}")
    info(f"Install directory: {XMRIG_DIR}")

    # Install system dependencies via pkg (Termux)
    info("Installing system dependencies...")
    deps = ["wget", "curl", "proot", "cmake", "make", "gcc", "libuv", "hwloc", "openssl-tool"]
    for dep in deps:
        subprocess.run(["pkg", "install", "-y", dep], capture_output=True)

    # Detect best XMRig binary for this architecture
    xmrig_arch = {"aarch64": "arm64", "armv8l": "arm64", "armv7l": "armv7"}.get(arch, "arm64")
    xmrig_url = f"https://github.com/xmrig/xmrig/releases/download/v{XMRIG_VERSION}/xmrig-{XMRIG_VERSION}-android-{xmrig_arch}.zip"

    info(f"Downloading XMRig v{XMRIG_VERSION} for {xmrig_arch}...")
    zip_path = CONFIG_DIR / "xmrig.zip"
    try:
        urllib.request.urlretrieve(xmrig_url, zip_path)
    except Exception as e:
        warn(f"Pre-built binary not available: {e}")
        warn("Falling back to source build (this may take a while)...")
        return cmd_install_source()

    # Extract
    info("Extracting XMRig...")
    XMRIG_DIR.mkdir(exist_ok=True)
    subprocess.run(["unzip", "-o", str(zip_path), "-d", str(XMRIG_DIR)], capture_output=True)
    zip_path.unlink()

    # Find the xmrig binary
    for f in XMRIG_DIR.rglob("xmrig"):
        if f.is_file() and os.access(f, os.X_OK):
            f.rename(XMRIG_BIN)
            break

    if not XMRIG_BIN.exists():
        err("Could not find xmrig binary after extraction.")
        return False

    XMRIG_BIN.chmod(0o755)
    ok(f"XMRig installed: {XMRIG_BIN}")

    # Generate default config
    cfg = load_config()
    generate_xmrig_config(cfg)
    INSTALL_MARKER.touch()
    
    ok("Installation complete!")
    info(f"Config: {CONFIG_FILE}")
    info(f"Run '{NAME} start' to begin mining")
    return True


def cmd_install_source():
    """Build XMRig from source (fallback for unsupported architectures)."""
    info("Building XMRig from source...")
    src_dir = CONFIG_DIR / "src"
    src_dir.mkdir(exist_ok=True)

    # Clone and build
    subprocess.run(
        ["git", "clone", "--depth", "1", "--branch", f"v{XMRIG_VERSION}",
         "https://github.com/xmrig/xmrig.git", str(src_dir / "xmrig")],
        capture_output=True
    )

    build_dir = src_dir / "build"
    build_dir.mkdir(exist_ok=True)

    result = subprocess.run(
        ["cmake", "..", "-DCMAKE_BUILD_TYPE=Release", "-DWITH_HTTPD=ON"],
        cwd=str(build_dir), capture_output=True, text=True
    )

    if result.returncode != 0:
        err(f"CMake failed: {result.stderr[-200:]}")
        return False

    result = subprocess.run(
        ["make", "-j$(nproc)"], cwd=str(build_dir), capture_output=True, text=True
    )

    if result.returncode != 0:
        err(f"Make failed: {result.stderr[-200:]}")
        return False

    # Copy binary
    built_bin = build_dir / "xmrig"
    if built_bin.exists():
        built_bin.rename(XMRIG_BIN)
        XMRIG_BIN.chmod(0o755)
        ok("XMRig built from source successfully!")
        return True
    
    err("Build completed but xmrig binary not found.")
    return False


def generate_xmrig_config(cfg):
    """Generate XMRig config.json."""
    config = {
        "autosave": True,
        "cpu": {
            "enabled": True,
            "max-threads-hint": cfg.get("max_cpu", 75),
        },
        # Both keys are written, but XMRig ignores them below
        # kMinimumDonateLevel (=1) unless the binary is patched. Verify on the
        # startup banner that it reads DONATE 0%.
        "donate-level": 0,
        "donate-over-proxy": 0,
        "pools": [{
            "url": cfg["pool"],
            "user": cfg["wallet"],
            "pass": cfg.get("worker", "android-node"),
            "keepalive": True,
            "nicehash": False,
        }],
        "api": {
            "enabled": True,
            "host": "127.0.0.1",
            "port": API_PORT,
            "access-token": None,
            "restricted": True,
        },
        "http": {
            "enabled": True,
            "host": "127.0.0.1",
            "port": API_PORT,
        },
    }
    XMRIG_DIR.mkdir(parents=True, exist_ok=True)
    xmrig_config = XMRIG_DIR / "config.json"
    xmrig_config.write_text(json.dumps(config, indent=2))
    ok("XMRig config generated")


def cmd_start():
    """Start the XMRig mining daemon."""
    if not INSTALL_MARKER.exists():
        warn("Not installed yet. Run 'xmrt-node install' first.")
        return

    # Hold an exclusive lock across the whole check-then-start sequence.
    # Without it, two concurrent starts (or a boot script racing a manual
    # start) can both pass the pid check and launch a second miner. A second
    # RandomX dataset on a phone will OOM-crash the device, and the loser of
    # the API port bind only logs "HTTP API server failed to start" - which
    # reads as a broken API rather than a duplicate miner.
    ensure_config_dir()
    lock_fp = open(LOCK_FILE, "w")
    try:
        fcntl.flock(lock_fp, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        warn("Another 'xmrt-node start' is in progress - skipping.")
        lock_fp.close()
        return

    try:
        pid = get_xmrig_pid()
        if pid:
            warn(f"XMRig is already running (PID {pid})")
            return

        cfg = load_config()
        xmrig_config = XMRIG_DIR / "config.json"
        if not xmrig_config.exists():
            generate_xmrig_config(cfg)

        info("Starting XMRig mining daemon...")

        # XMRig block-buffers stdout when it is not a TTY, so redirecting
        # stdout leaves the log empty for the life of the process. Pass
        # --log-file and let XMRig write its own log line by line.
        log_fp = open(LOG_FILE, "a")
        proc = subprocess.Popen(
            [str(XMRIG_BIN), "--config", str(xmrig_config), "--no-color",
             "--log-file", str(XMRIG_LOG)],
            stdout=log_fp, stderr=subprocess.STDOUT,
            stdin=subprocess.DEVNULL,
            start_new_session=True,
        )

        PID_FILE.write_text(str(proc.pid))
        ok(f"XMRig started (PID {proc.pid})")
        info(f"Miner log: {XMRIG_LOG}")
        info("Verify on the startup banner: DONATE must read 0%")

        # Send startup heartbeat to relay
        relay_post("/api/fleet/heartbeat", {
            "agent_id": AGENT_ID,
            "name": "XMRT Node (Termux)",
            "role": "miner",
            "status": "ONLINE",
            "hashrate": 0,
            "device_type": "android-termux",
            "version": VERSION,
            "metadata": {"pid": proc.pid, "event": "started"},
        })
    finally:
        fcntl.flock(lock_fp, fcntl.LOCK_UN)
        lock_fp.close()


def cmd_stop():
    """Stop the XMRig mining daemon."""
    pid = get_xmrig_pid()
    if not pid:
        warn("XMRig is not running.")
        return

    info(f"Stopping XMRig (PID {pid})...")
    try:
        os.kill(pid, signal.SIGTERM)
        time.sleep(2)
        os.kill(pid, signal.SIGKILL)
    except ProcessLookupError:
        pass

    PID_FILE.unlink(missing_ok=True)
    ok("XMRig stopped")

    # Send stop heartbeat
    cfg = load_config()
    relay_post("/api/fleet/heartbeat", {
        "agent_id": AGENT_ID,
        "name": "XMRT Node (Termux)",
        "role": "miner",
        "status": "OFFLINE",
        "hashrate": 0,
        "device_type": "android-termux",
        "version": VERSION,
        "metadata": {"event": "stopped", "worker": cfg.get("worker")},
    })


